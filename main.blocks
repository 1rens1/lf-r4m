if (!leftOnLine &amp;&amp; !rightOnLine) {
Motor.set(Motor.LEFT, 0, Motor.MAX_SPEED);
Motor.set(Motor.RIGHT, 1, Motor.MAX_SPEED);
}
if (!leftOnLine &amp;&amp; rightOnLine) {
Motor.set(Motor.LEFT, 0, Motor.MAX_SPEED);
Motor.set(Motor.RIGHT, 1, 0);
}
if (leftOnLine &amp;&amp; !rightOnLine) {
Motor.set(Motor.LEFT, 0, 0);
Motor.set(Motor.RIGHT, 1, Motor.MAX_SPEED);
}
